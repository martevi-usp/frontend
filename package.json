{
  "name": "martevi-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "tsc -b && vite build --config config/vite.config.ts",
    "lint": "oxlint -c config/.oxlintrc.json",
    "preview": "vite preview --config config/vite.config.ts",
    "predeploy": "node -e \"if (!process.env.VITE_API_URL) { console.error('Set VITE_API_URL to the backend URL first, e.g. VITE_API_URL=https://<service>.run.app npm run deploy'); process.exit(1) }\"",
    "deploy": "npm run build && npx wrangler deploy",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "typecheck": "tsc -b && tsc -p config/tsconfig.test.json"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@mui/material": "^9.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
